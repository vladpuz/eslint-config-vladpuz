{
  "name": "eslint-config-vladpuz",
  "version": "4.4.2",
  "description": "My ESLint config",
  "keywords": [
    "eslint",
    "eslintconfig",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladpuz/eslint-config-vladpuz.git"
  },
  "license": "MIT",
  "author": "Vladislav Puzyrev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format",
    "format": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build && npm run check && npm run test",
    "prepare": "husky",
    "test": "node --test",
    "test-update-snapshots": "node --test --test-update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^26.0.1",
    "@tsconfig/node-ts": "^23.6.5",
    "@tsconfig/strictest": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-config-vladpuz": "^3.0.2",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10",
    "typescript": "^6"
  }
}
